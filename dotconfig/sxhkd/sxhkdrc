super + F1
	sys-mount-disk

super + F2
	sys-mount-phone

super + F3
	sys-unmount-disk

super + F4
	sys-unmount-phone

super + F5 
	brightnessctl set 5%+

super + F6
	brightnessctl set 5%-

super + b
	smci

super + r
	pkill -USR1 -x sxhkd || (pkill sxhkd && sxhkd &)

super + Up
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

super + Down
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

