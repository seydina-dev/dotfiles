-- Hyprland Lua config
-- Refer to the wiki for more information.
-- https://wiki.hypr.land/Configuring/
--
-- This file replaces hyprland.conf and all sourced sub-configs.
-- Sub-modules live in lua/ and are required below.
-- NOTE: monitors.conf and workspaces.conf are still auto-generated by nwg-displays.
-- They are loaded via the legacy source mechanism by keeping a thin hyprland.conf shim,
-- OR you manage monitors directly here. See lua/monitors.lua for the current approach.

require("lua/env")
require("lua/monitors")
require("lua/autostart")
require("lua/look_and_feel")
require("lua/input")
require("lua/window_rules")
require("lua/keybinds")
